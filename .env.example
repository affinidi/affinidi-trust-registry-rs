## DID of the mediator to connect to
MEDIATOR_DID="did:web:your-mediator-did.io"

## Transport flags. Each one governs BOTH whether the transport is served and
## whether the DID document advertises it, so the registry can never advertise
## a transport it does not answer. At least one must be 'true'.
##   ENABLE_REST     serve TRQP over REST, advertise `TRQPRest`   (default true)
##   ENABLE_DIDCOMM  run the DIDComm listener, advertise `DIDCommMessaging`
##                                                               (default true)
##   ENABLE_TSP      route TSP frames, advertise `TSPTransport`  (default false)
## ENABLE_TSP=true additionally requires ENABLE_DIDCOMM=true (TSP frames are
## multiplexed on the DIDComm mediator socket) and a binary built with
## `--features tsp`. Both are enforced at startup.
#ENABLE_REST=true
#ENABLE_DIDCOMM=true
#ENABLE_TSP=false

## Externally reachable base URL of the REST/TRQP surface. When set, the DID
## document advertises a `TRQPRest` service so peers can find the REST endpoint
## by resolving the Trust Registry's DID. Must be https:// (loopback http://
## is allowed for local dev). With ENABLE_REST=true but this unset, REST is
## still served — it is just not advertised, so peers cannot discover it by DID.
#TR_PUBLIC_URL=https://registry.example.org
## Admin DIDs allowed to manage the Trust Registry
ADMIN_DIDS=did:peer:2.Vz6Mkpun7xEJWBqwtaiHSqfjLe1ejqQ4PAUEas1gjH7VVNxjs.EzQ3shoprXELvJw9ou4VbfrFRx5FZQsP9EB1LMUJaPacDKtiZ8
## ExplicitDeny for public ACLs mode, ExplicitAllow for private ACLs mode
ACL_MODE=ExplicitDeny # Options: ExplicitDeny, ExplicitAllow
# Other Trust Registry configuration
AUDIT_LOG_FORMAT=json # Options: text, json
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Secret-store backend for the custodied identity (profile bundle / offline
# cache). Opt-in, built with the matching `secrets-*` feature. The first
# configured backend wins in priority order: AWS > GCP > Azure > Vault > K8s
# Secret > config-seed > keyring > plaintext. Uncomment ONE group. Full
# reference: README "Secret-store backends (secrets-*)".
#
## AWS Secrets Manager (feature: secrets-aws)
#TR_SECRETS_AWS_SECRET_NAME=tr/master-seed
#TR_SECRETS_AWS_REGION=us-east-1
#
## GCP Secret Manager (feature: secrets-gcp)
#TR_SECRETS_GCP_SECRET_NAME=tr-master-seed
#TR_SECRETS_GCP_PROJECT=my-project-id
#
## Azure Key Vault (feature: secrets-azure)
#TR_SECRETS_AZURE_VAULT_URL=https://my-vault.vault.azure.net
#TR_SECRETS_AZURE_SECRET_NAME=tr-master-seed
#
## HashiCorp Vault (feature: secrets-vault). Kubernetes auth is the default and
## REQUIRES the role; token/approle auth switch via TR_SECRETS_VAULT_AUTH_METHOD.
#TR_SECRETS_VAULT_ADDR=https://vault.svc.cluster.local:8200   # or VAULT_ADDR
#TR_SECRETS_VAULT_SECRET_PATH=tr/master-seed
#TR_SECRETS_VAULT_AUTH_METHOD=kubernetes                      # kubernetes|token|approle
#TR_SECRETS_VAULT_K8S_ROLE=trust-registry                     # required for kubernetes auth
##TR_SECRETS_VAULT_KV_MOUNT=secret
##TR_SECRETS_VAULT_SECRET_KEY=seed
##VAULT_TOKEN=hvs.xxx                                         # token auth
##TR_SECRETS_VAULT_APPROLE_ROLE_ID=...                        # approle auth
##TR_SECRETS_VAULT_APPROLE_SECRET_ID=...
#
## Kubernetes Secret (feature: secrets-k8s)
#TR_SECRETS_K8S_SECRET_NAME=tr-master-seed
#TR_SECRETS_K8S_NAMESPACE=tr-prod                             # or inject via Downward API
##TR_SECRETS_K8S_SECRET_KEY=seed
#
## OS keyring (feature: secrets-keyring; interactive on macOS)
#TR_SECRETS_KEYRING_SERVICE=trust-registry
#
## Config-seed / plaintext file (default feature secrets-config)
#TR_SECRETS_SEED=<hex-encoded-seed>                           # config-seed
#TR_SECRETS_ALLOW_PLAINTEXT=true                              # plaintext file — dev/test only
#TR_SECRETS_DATA_DIR=./.trust-registry