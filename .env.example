# Trust Registry Environment Configuration
## The full reference, with every variable and its default, is the
## "Environment Variables" section of the README. A value that does not parse
## stops startup with an error naming the variable; unset means the default.

# --- Trust record storage --------------------------------------------------
## csv (default) | dynamodb (or ddb) | redis | fjall (--features storage-fjall).
## Any other value stops startup.
TR_STORAGE_BACKEND='csv'
## csv: the file to read (default trust_records.csv) and how often, in
## seconds, to check it for changes (default 60; must be at least 1).
FILE_STORAGE_PATH='./sample-data/data.csv'
#FILE_STORAGE_UPDATE_INTERVAL_SEC=60
## dynamodb: required. The table needs string keys PK (hash) and SK (range);
## see the README "DynamoDB storage" section.
#DDB_TABLE_NAME='trust-registry-records'
## dynamodb: optional. Unset region => the AWS SDK resolves it.
#AWS_REGION=eu-west-1
#AWS_PROFILE=trust-registry
## dynamodb: DynamoDB Local / LocalStack only.
#DYNAMODB_ENDPOINT=http://localhost:8000
#DDB_USE_TEST_CREDENTIALS=true
## redis: required.
#REDIS_URL='redis://localhost:6379'
## fjall: optional (default ./trust_records.fjall).
#TR_FJALL_PATH=./trust_records.fjall
## The record of accepted Trust Task documents (replay of redelivered writes).
## Kept in Redis / DynamoDB / fjall with those backends, in memory with csv.
## Retention: 360 to 86400 seconds. In-flight lease: 60 to 299 seconds.
#TR_DEDUP_RETENTION_SEC=420
#TR_DEDUP_IN_FLIGHT_LEASE_SEC=120
## Bounds of a record kept in process memory (csv, in-memory, fjall's index).
#TR_DEDUP_MAX_ENTRIES=100000
#TR_DEDUP_MAX_ENTRIES_PER_ISSUER=10000

# --- HTTP server -----------------------------------------------------------
## Socket address the REST/TRQP HTTP server (and /health) binds to. Not bound
## at all when ENABLE_REST=false.
#LISTEN_ADDRESS=0.0.0.0:3232
## Unset: no cross-origin access (same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
## Where capability enablement state is kept.
#TR_CAPABILITY_STATE=./.trust-registry/capabilities.json

# --- Transports ------------------------------------------------------------
## Each flag governs BOTH whether the transport is served and whether the DID
## document advertises it, so the registry can never advertise a transport it
## does not answer. At least one must be 'true'.
##   ENABLE_REST     serve TRQP over REST, advertise `TRQPRest`   (default true)
##   ENABLE_DIDCOMM  run the DIDComm listener, advertise `DIDCommMessaging`
##                                                               (default true)
##   ENABLE_TSP      route TSP frames, advertise `TSPTransport`  (default false)
## ENABLE_TSP=true additionally requires ENABLE_DIDCOMM=true (TSP frames are
## multiplexed on the DIDComm mediator socket) and a binary built with
## `--features tsp`. Both are enforced at startup.
##
## DIDComm is off in this example so it starts without a mediator or an
## identity. To enable it, run `setup-trust-registry` (see the README), which
## writes MEDIATOR_DID and PROFILE_CONFIG for you.
ENABLE_DIDCOMM=false
#ENABLE_REST=true
#ENABLE_TSP=false

## Externally reachable base URL of the REST/TRQP surface. When set, the DID
## document advertises a `TRQPRest` service so peers can find the REST endpoint
## by resolving the Trust Registry's DID. Must be https:// (loopback http://
## is allowed for local dev). With ENABLE_REST=true but this unset, REST is
## still served — it is just not advertised, so peers cannot discover it by DID.
#TR_PUBLIC_URL=https://registry.example.org

# --- DIDComm (read only when ENABLE_DIDCOMM=true) ----------------------------
## DID of the mediator to connect to. Required.
#MEDIATOR_DID="did:web:your-mediator-did.io"
## The registry's DID and private keys, as inline JSON or a loader URI
## (string://, file://, aws_secrets://, aws_parameter_store://). Required unless
## the identity comes from a VTA (TR_VTA_CREDENTIAL) or a secret store
## (TR_SECRETS_*). Sensitive: setup-trust-registry generates it.
#PROFILE_CONFIG=file:///etc/trust-registry/profile.json
## Optional: a DID document (loader value, JSON) to publish instead of the
## generated one.
#DID_DOCUMENT=file:///etc/trust-registry/did.json
## Admin DIDs allowed to manage the Trust Registry (comma-separated). Empty:
## no admin. List only DIDs whose keys you hold; the test client prints the DID
## it generates on its first run, for a local setup.
#ADMIN_DIDS=
## Each admin may write records only under its own DID as authority_id. To let
## an admin also write under other authorities, map it to them here (JSON).
#ADMIN_AUTHORITIES={"did:web:ops.example":["did:web:community-a.example"]}
## ExplicitDeny (public, default) or ExplicitAllow (private).
#ACL_MODE=ExplicitDeny
## json (default) or text.
#AUDIT_LOG_FORMAT=json
## did:web only: how often to check the DID document is reachable before the
## listener starts (positive whole numbers; max delay >= initial delay).
#DID_CHECK_MAX_ATTEMPTS=10
#DID_CHECK_INITIAL_DELAY_SECS=2
#DID_CHECK_MAX_DELAY_SECS=20
## TSP (ENABLE_TSP=true): where the messaging store lives (default
## <TR_SECRETS_DATA_DIR>/messaging, else ./.trust-registry/messaging) and the
## bounds on the relationship store.
#TR_MESSAGING_STORE_PATH=./.trust-registry/messaging
#TR_TSP_MAX_RELATIONSHIPS=10000
#TR_TSP_MAX_NEW_RELATIONSHIPS_PER_MINUTE=60
#TR_TSP_RELATIONSHIP_IDLE_SECS=604800

# --- Secret-store backend for the identity (opt-in) ------------------------
# Built with the matching `secrets-*` feature. TR_SECRETS_BACKEND names the
# backend; without it, the backend is the one whose activating variable is
# set, and setting more than one is an error. Uncomment ONE group. Full
# reference: README "Secret-store backends (secrets-*)".
#
#TR_SECRETS_BACKEND=aws        # aws|gcp|azure|vault|kubernetes|config_seed|keyring|plaintext
#
## AWS Secrets Manager (feature: secrets-aws)
#TR_SECRETS_AWS_SECRET_NAME=tr/profile
#TR_SECRETS_AWS_REGION=us-east-1
#
## GCP Secret Manager (feature: secrets-gcp) — both required
#TR_SECRETS_GCP_SECRET_NAME=tr-profile
#TR_SECRETS_GCP_PROJECT=my-project-id
#
## Azure Key Vault (feature: secrets-azure) — both required
#TR_SECRETS_AZURE_VAULT_URL=https://my-vault.vault.azure.net
#TR_SECRETS_AZURE_SECRET_NAME=tr-profile
#
## HashiCorp Vault (feature: secrets-vault). The secret path selects Vault and
## needs an address; VAULT_ADDR / VAULT_TOKEN are honoured only then.
## Kubernetes auth is the default and REQUIRES the role; token/approle auth
## switch via TR_SECRETS_VAULT_AUTH_METHOD.
#TR_SECRETS_VAULT_ADDR=https://vault.svc.cluster.local:8200   # or VAULT_ADDR
#TR_SECRETS_VAULT_SECRET_PATH=tr/profile
#TR_SECRETS_VAULT_AUTH_METHOD=kubernetes                      # kubernetes|token|approle
#TR_SECRETS_VAULT_K8S_ROLE=trust-registry                     # required for kubernetes auth
##TR_SECRETS_VAULT_KV_MOUNT=secret
##TR_SECRETS_VAULT_SECRET_KEY=seed
##VAULT_TOKEN=hvs.xxx                                         # token auth
##TR_SECRETS_VAULT_APPROLE_ROLE_ID=...                        # approle auth
##TR_SECRETS_VAULT_APPROLE_SECRET_ID=...
#
## Kubernetes Secret (feature: secrets-k8s)
#TR_SECRETS_K8S_SECRET_NAME=tr-profile
#TR_SECRETS_K8S_NAMESPACE=tr-prod                             # or inject via Downward API
##TR_SECRETS_K8S_SECRET_KEY=seed
#
## OS keyring (feature: secrets-keyring; interactive on macOS)
#TR_SECRETS_BACKEND=keyring
#TR_SECRETS_KEYRING_SERVICE=trust-registry
#
## Config-seed (default feature secrets-config): the profile bundle JSON,
## hex-encoded. Read-only.
#TR_SECRETS_SEED=<hex of the profile bundle JSON>
#
## Plaintext file — dev/test only
#TR_SECRETS_BACKEND=plaintext
#TR_SECRETS_ALLOW_PLAINTEXT=true
#TR_SECRETS_DATA_DIR=./.trust-registry
