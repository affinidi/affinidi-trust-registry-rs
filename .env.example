# Trust Registry Environment Configuration
## See the Environment Variable section of the README for more details

# Trust Registry storage configuration
TR_STORAGE_BACKEND='csv'
## Required if TR_STORAGE_BACKEND is 'csv'
FILE_STORAGE_PATH='./sample-data/data.csv'
## Reuired if TR_STORAGE_BACKEND is 'ddb'
DDB_TABLE_NAME='test'
## Required if TR_STORAGE_BACKEND is 'redis'
REDIS_URL='redis://localhost:6379'

