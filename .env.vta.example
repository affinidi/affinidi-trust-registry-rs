# =============================================================================
# Trust Registry — VTA mode environment template
# =============================================================================
# Copy to `.env` and fill in the values. See VTA_SETUP.md for the end-to-end
# provisioning flow (pnm commands) that produces the credential bundle.
#
# Build the server with the `vta` feature:
#   cargo build --release --bin trust-registry --features vta
# (add a secrets backend feature, e.g. secrets-aws, for the offline cache; a
#  plain `vta` build can only cache to a plaintext file, dev/test only)
# =============================================================================

# --- DIDComm (required for VTA) ---------------------------------------------
# VTA startup only runs inside the DIDComm path. If ENABLE_DIDCOMM is not "true"
# the VTA is never consulted.
ENABLE_DIDCOMM=true
MEDIATOR_DID=did:web:CHANGEME-mediator.example

# --- VTA identity -----------------------------------------------------------
# TR_VTA_CREDENTIAL: the credential bundle recovered from `pnm bootstrap open`.
# Accepts a URI loaded value:
#   file:///path/to/vta-credential.json
#   aws_secrets://<secret-name>
#   aws_parameter_store://<param-name>
#   string://{"did":"...","privateKeyMultibase":"...","vtaDid":"...","vtaUrl":"..."}
TR_VTA_CREDENTIAL=file:///etc/trust-registry/vta-credential.json

# TR_VTA_CONTEXT_ID: the context slug (`--id`) used in `pnm contexts provision`.
# Required whenever TR_VTA_CREDENTIAL is set.
TR_VTA_CONTEXT_ID=trust-registry

# TR_VTA_URL (optional): overrides the vtaUrl field inside the credential bundle.
#TR_VTA_URL=https://vta.example.com

# TR_ALIAS (optional): profile alias. Defaults to "Trust Registry".
#TR_ALIAS=Trust Registry

# --- Offline cache (recommended) ------------------------------------------
# If the VTA is unreachable at boot, the last bundle is loaded from the secret
# store selected below. There is NO cache unless you configure one: a `vta`
# build has no keyring, so with no backend below startup warns
# "VTA offline cache unavailable" and the registry cannot start while the VTA
# is down. If the VTA is down AND the cache is empty, startup fails — there is
# no fallback to PROFILE_CONFIG.
#
# The cache is kept in its own slot: the secret name (or Vault path, K8s
# Secret name, keyring service) below with "-vta-cache" appended. Uncomment ONE
# group, or name the backend with TR_SECRETS_BACKEND.
#
# AWS Secrets Manager (build --features "vta,secrets-aws"); cache in
# trust-registry-vta-cache:
#TR_SECRETS_AWS_SECRET_NAME=trust-registry
#TR_SECRETS_AWS_REGION=ap-southeast-1
#
# GCP Secret Manager (secrets-gcp) — both required:
#TR_SECRETS_GCP_PROJECT=my-project
#TR_SECRETS_GCP_SECRET_NAME=trust-registry
#
# Azure Key Vault (secrets-azure) — both required:
#TR_SECRETS_AZURE_VAULT_URL=https://myvault.vault.azure.net
#TR_SECRETS_AZURE_SECRET_NAME=trust-registry
#
# HashiCorp Vault (secrets-vault). The path is under the KV mount (default
# `secret`), so do not repeat the mount. The default auth method is
# `kubernetes`, which needs the role; for token auth set the method too.
#TR_SECRETS_VAULT_ADDR=https://vault.example:8200
#TR_SECRETS_VAULT_SECRET_PATH=trust-registry
#TR_SECRETS_VAULT_AUTH_METHOD=kubernetes        # kubernetes|token|approle
#TR_SECRETS_VAULT_K8S_ROLE=trust-registry       # kubernetes auth
#TR_SECRETS_VAULT_TOKEN=hvs.xxx                 # token auth (or VAULT_TOKEN)
#
# Kubernetes Secret (secrets-k8s):
#TR_SECRETS_K8S_SECRET_NAME=trust-registry
#TR_SECRETS_K8S_NAMESPACE=default
#
# Dev/test only: a plaintext file in <TR_SECRETS_DATA_DIR>/vta-cache/
# (default ./.trust-registry/vta-cache/):
#TR_SECRETS_ALLOW_PLAINTEXT=true
#TR_SECRETS_DATA_DIR=./.trust-registry

# NOTE: do NOT set PROFILE_CONFIG in VTA mode — VTA takes precedence and it will
# not be read.

# --- Server -----------------------------------------------------------------
LISTEN_ADDRESS=0.0.0.0:3232
# Browser origins allowed to call the REST API; unset = same-origin only.
#CORS_ALLOWED_ORIGINS=https://app.example.com
ACL_MODE=ExplicitDeny
AUDIT_LOG_FORMAT=json
RUST_LOG=info
